# Kopiér denne fil til .env og udfyld med jeres egne oplysninger.
# .env ligger bevidst uden for git (se .gitignore) og må aldrig committes.

# Database (MySQL eller MariaDB)
DB_HOST=localhost
DB_NAME=bms_projekt
DB_USER=bms_projekt
DB_PASS=aendr-mig

# production | udvikling
APP_ENV=produktion

# Navn på PHP-sessionscookien (kan ændres hvis flere PHP-sites deler domæne)
SESSION_NAME=bms_projekt_session
